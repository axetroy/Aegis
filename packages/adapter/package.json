{
  "name": "@aegis/adapter",
  "version": "0.1.0",
  "description": "Aegis Adapter - application code loading adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extract-aegis-package": {
      "source": "./src/extract-aegis-package.ts",
      "types": "./dist/extract-aegis-package.d.ts",
      "import": "./dist/extract-aegis-package.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@aegis/protocol": "workspace:*",
    "@aegis/packager": "workspace:*",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
