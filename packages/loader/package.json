{
  "name": "@aegis/loader",
  "version": "0.1.0",
  "description": "Aegis module loader with sandbox execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aegis/protocol": "workspace:*",
    "@aegis/packager": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
