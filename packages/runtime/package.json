{
  "name": "@aegis/runtime",
  "version": "0.1.0",
  "description": "Aegis Worker Runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@aegis/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-reconciler": "^0.34.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0",
    "typescript": "^5.9.3"
  }
}
