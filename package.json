{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aegis - 让不受信任的代码构建 UI，但永远不能拥有宿主",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm -r --if-present run typecheck",
    "typecheck:apps": "pnpm -r --if-present run typecheck",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:all": "pnpm -r --if-present run typecheck && pnpm typecheck:scripts",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r clean",
    "aegis:build": "tsx scripts/aegis-build.ts build",
    "aegis": "tsx scripts/aegis-build.ts"
  },
  "devDependencies": {
    "@aegis/packager": "workspace:*",
    "@aegis/protocol": "workspace:*",
    "@aegis/react": "workspace:*",
    "@aegis/renderer": "workspace:*",
    "@aegis/runtime": "workspace:*",
    "@aegis/ui": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
